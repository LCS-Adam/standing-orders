.DS_Store
*.bak-*
/dist/

# agent worktrees are transient and local
.worktrees/

# agent run reports. agents/exec-*.md default every report to runtime/verify/,
# and an unignored report lands in the shipped set: check 1 then scans the
# absolute worktree paths an agent naturally writes there and fails the gate on
# output that was never meant to ship.
runtime/

# Upstream clones (scripts/sync-upstream.sh). Read material, not our code:
# tracked would make this repo a fork of every project it references.
.upstream/

# Local Auggie scratch. `harness add --tool auggie` writes it into whatever repo
# you run it in; in THIS repo the distributable copy is the plugin tree, which
# check 13 re-derives and diffs. An exemption nothing verifies is not earned.
.augment/
